<Window x:Class="WanwanDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Width="160" Height="160"
        Left="80" Top="80"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="开始录音" Click="StartRecord_Click"/>
            <MenuItem Header="停止录音并发送" Click="StopRecord_Click"/>
            <MenuItem Header="取消录音" Click="CancelRecord_Click"/>
            <Separator/>
            <MenuItem Header="选择音频并运行" Click="ChooseAudio_Click"/>
            <Separator/>
            <MenuItem Header="打开设置" Click="OpenSettings_Click"/>
            <MenuItem Header="打开日志窗口" Click="OpenLogWindow_Click"/>
            <MenuItem Header="打开日志文件夹" Click="OpenLogFolder_Click"/>
            <Separator/>
            <MenuItem Header="退出" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Canvas Width="160" Height="160">
        <Ellipse Canvas.Left="18" Canvas.Top="28" Width="124" Height="124"
                 Fill="#FFF7F0" Stroke="#3F2D2D" StrokeThickness="3"/>
        <Polygon Points="42,30 56,6 74,34" Fill="#FFF7F0" Stroke="#3F2D2D" StrokeThickness="3"/>
        <Polygon Points="118,30 104,6 86,34" Fill="#FFF7F0" Stroke="#3F2D2D" StrokeThickness="3"/>
        <Ellipse Canvas.Left="52" Canvas.Top="68" Width="14" Height="18" Fill="#2C2230"/>
        <Ellipse Canvas.Left="94" Canvas.Top="68" Width="14" Height="18" Fill="#2C2230"/>
        <Ellipse Canvas.Left="58" Canvas.Top="74" Width="4" Height="4" Fill="White"/>
        <Ellipse Canvas.Left="100" Canvas.Top="74" Width="4" Height="4" Fill="White"/>
        <Ellipse Canvas.Left="72" Canvas.Top="96" Width="16" Height="12"
                 Fill="#FFB3C1" Stroke="#3F2D2D" StrokeThickness="2"/>
        <Path Stroke="#3F2D2D" StrokeThickness="3" Data="M 62,108 Q 80,130 98,108"/>
        <Ellipse Canvas.Left="28" Canvas.Top="96" Width="22" Height="22" Fill="#FFD5DF"/>
        <Ellipse Canvas.Left="110" Canvas.Top="96" Width="22" Height="22" Fill="#FFD5DF"/>
        <TextBlock x:Name="PetLabel" Canvas.Left="62" Canvas.Top="138"
                   Text="晚晚" Foreground="#6B4E71"
                   FontFamily="Microsoft YaHei UI" FontSize="12" FontWeight="Bold"
                   TextAlignment="Center" Width="36"/>
        <TextBlock x:Name="StatusLabel" Canvas.Left="50" Canvas.Top="18"
                   Text="待命" Foreground="#3F2D2D"
                   FontFamily="Microsoft YaHei UI" FontSize="10" FontWeight="Bold"
                   TextAlignment="Center" Width="60"/>
        <TextBlock x:Name="ResultLabel" Canvas.Left="10" Canvas.Top="140"
                   Text="" Foreground="#3F2D2D"
                   FontFamily="Microsoft YaHei UI" FontSize="8"
                   TextAlignment="Center" Width="140"
                   TextWrapping="Wrap" MaxHeight="20"/>
    </Canvas>
</Window>
