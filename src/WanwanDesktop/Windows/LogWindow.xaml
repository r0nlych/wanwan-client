<Window x:Class="WanwanDesktop.Windows.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日志查看器" Height="520" Width="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="刷新" Click="Refresh_Click" Width="50" Margin="0,0,4,0"/>
            <Button Content="清空日志" Click="ClearLog_Click" Width="70" Margin="0,0,4,0"/>
            <Button Content="打开日志文件夹" Click="OpenFolder_Click" Width="100" Margin="0,0,8,0"/>

            <RadioButton x:Name="DebugLogRadio" Content="Python 调试日志"
                         Checked="LogRadio_Checked" Margin="0,0,4,0"/>
            <RadioButton x:Name="DesktopLogRadio" Content="桌面端日志"
                         Checked="LogRadio_Checked" Margin="0,0,4,0"/>

            <Button Content="关闭" Click="Close_Click" Width="50" HorizontalAlignment="Right" Margin="4,0,0,0"/>
        </StackPanel>

        <TextBox x:Name="LogTextBox" Grid.Row="1"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="11"
                 TextWrapping="NoWrap"
                 AcceptsReturn="True"/>
    </Grid>
</Window>
