<Window x:Class="WanwanDesktop.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="640" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="ServiceTab" Margin="0,0,0,8"
                    SelectionChanged="ServiceTab_SelectionChanged">
            <TabItem Header="LLM"/>
            <TabItem Header="STT"/>
            <TabItem Header="TTS"/>
            <TabItem Header="音频"/>
        </TabControl>

        <!-- LLM/STT/TTS 字段区 -->
        <ScrollViewer Grid.Row="1" x:Name="FieldsScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid x:Name="FieldsGrid" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
                <Button x:Name="TtsTestButton" Content="测试 TTS" Click="TestTts_Click"
                        Width="80" Margin="0,12,0,0" HorizontalAlignment="Right"
                        Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 音频设置面板（通过 CS 显式添加到 Grid.Row=1 或移除） -->
        <StackPanel x:Name="AudioPanel" Grid.Row="1"
                    Visibility="Collapsed" Margin="0,8,0,0">
            <GroupBox Header="播放语音音量" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="VoiceVolumeSlider" Grid.Column="0"
                            Minimum="0.1" Maximum="2.0"
                            SmallChange="0.1" LargeChange="0.2"
                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                            Value="1.0"
                            VerticalAlignment="Center"
                            ValueChanged="VoiceVolumeSlider_ValueChanged"/>
                    <TextBlock x:Name="VoiceVolumeLabel" Grid.Column="1"
                               Text="100%" VerticalAlignment="Center"
                               TextAlignment="Right"/>
                </Grid>
            </GroupBox>
            <Button x:Name="TestVolumeButton" Content="测试音量"
                    Click="TestVolume_Click"
                    Width="80" Margin="0,12,0,0" HorizontalAlignment="Right"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="保存设置" Click="Save_Click" Width="80" Margin="0,0,8,0"/>
            <Button Content="取消" Click="Cancel_Click" Width="60"/>
        </StackPanel>
    </Grid>
</Window>
