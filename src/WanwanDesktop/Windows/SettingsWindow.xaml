<Window x:Class="WanwanDesktop.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="640" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="ServiceTab" Margin="0,0,0,8"
                    SelectionChanged="ServiceTab_SelectionChanged">
            <TabItem Header="LLM"/>
            <TabItem Header="STT"/>
            <TabItem Header="TTS"/>
        </TabControl>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="FieldsGrid" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="保存设置" Click="Save_Click" Width="80" Margin="0,0,8,0"/>
            <Button Content="取消" Click="Cancel_Click" Width="60"/>
        </StackPanel>
    </Grid>
</Window>
